{
  "redirects": [
    { "source": "/portfolio", "destination": "/", "permanent": true },
    { "source": "/clients", "destination": "/", "permanent": true },
    { "source": "/info", "destination": "/", "permanent": true },
    { "source": "/contact-us", "destination": "/#contact", "permanent": true },
    { "source": "/media", "destination": "/#videos", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/commercial/:path*",
      "destination": "/commercial/:path*"
    },
    {
      "source": "/downloads/:path*",
      "destination": "/downloads/:path*"
    },
    {
      "source": "/((?!commercial/|downloads/).*)",
      "destination": "/index.html"
    }
  ]
}
